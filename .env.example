# ---------------------------------------------------------------------------
# Visit Rwanda Academy - environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon, Supabase, RDS, Railway...).
# Leave empty for local development: an embedded PostgreSQL (PGlite) instance
# is created under ./.pglite automatically. Never use PGlite in production.
DATABASE_URL=

# Strong random string used to sign the session cookie hash and reset tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production: without it sessions are never signed and the
# administrator area answers 503 instead of trusting a known fallback secret.
AUTH_SECRET=

# Public origin used in emails, password reset links and the sitemap/robots URLs.
# Set it to the real domain in production so sitemap entries are not localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Initial administrator. Create it with: npm run admin:create
# (reads these variables, or pass --email --password flags). Never commit values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Transactional email (optional). When RESEND_API_KEY is unset, booking
# acknowledgements are written to the server log and stored in the admin inbox.
RESEND_API_KEY=
MAIL_FROM="Visit Rwanda Academy <bookings@example.com>"
ADMIN_NOTIFICATION_EMAIL=
